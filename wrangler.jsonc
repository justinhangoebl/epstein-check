{
  "name": "epstein-check",
  "compatibility_date": "2026-02-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Cloudflare Browser Rendering — launches a real headless Chrome
  // inside the Worker to bypass Akamai TLS fingerprinting.
  // Free plan: 10 min/day, 3 concurrent browsers.
  // Paid plan ($5/mo): 10 hrs/month, 10 concurrent browsers.
  "browser": {
    "binding": "BROWSER"
  }
}
